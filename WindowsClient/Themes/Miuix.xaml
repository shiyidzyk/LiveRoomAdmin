<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 主题标识 -->
    <sys:String x:Key="ThemeName">miuix</sys:String>

    <!-- Miuix：米黄 / 淡橄榄绿配色，参考 MIUI·HyperOS 与 KernelSU Miuix 风格 -->
    <SolidColorBrush x:Key="ThemeBrush" Color="#7C8C56"/>
    <SolidColorBrush x:Key="BgBrush" Color="#E8EAD8"/>
    <SolidColorBrush x:Key="CardBrush" Color="#F3F5E5"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#33372A"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#4C5438"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#3E4430"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#383D2E"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#787E68"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D9DCC4"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#6FA85F"/>
    <SolidColorBrush x:Key="RedBrush" Color="#D96B5F"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#E0A93F"/>
    <SolidColorBrush x:Key="SecondaryBgBrush" Color="#DFE2CC"/>

    <SolidColorBrush x:Key="NavTextBrush" Color="#D3D7C2"/>
    <SolidColorBrush x:Key="NavSubTextBrush" Color="#A6AB93"/>

    <!-- 开关：深橄榄底 + 米白旋钮（MIUI 胶囊） -->
    <SolidColorBrush x:Key="SwitchOnBrush" Color="#6E7E48"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#C3C6AE"/>
    <SolidColorBrush x:Key="SwitchKnobBrush" Color="#F6F4E2"/>

    <!-- 圆角：MIUI 大圆角 -->
    <CornerRadius x:Key="CardRadius">22</CornerRadius>
    <CornerRadius x:Key="BtnRadius">14</CornerRadius>
    <CornerRadius x:Key="SwitchRadius">13</CornerRadius>
</ResourceDictionary>
