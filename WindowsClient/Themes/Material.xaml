<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 主题标识 -->
    <sys:String x:Key="ThemeName">material</sys:String>

    <!-- Material You：低饱和淡灰背景、白色卡片、蓝色强调、大圆角 -->
    <SolidColorBrush x:Key="ThemeBrush" Color="#4E6EF2"/>
    <SolidColorBrush x:Key="BgBrush" Color="#F4F5F2"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#1E2024"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#34383F"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#2A2E34"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1E1D"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B605F"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E5E1"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#2DB46A"/>
    <SolidColorBrush x:Key="RedBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#F2A93B"/>
    <SolidColorBrush x:Key="SecondaryBgBrush" Color="#E7E9E5"/>

    <SolidColorBrush x:Key="NavTextBrush" Color="#C9CDD4"/>
    <SolidColorBrush x:Key="NavSubTextBrush" Color="#9AA1AC"/>

    <!-- 开关：Material 蓝底 + 白旋钮 -->
    <SolidColorBrush x:Key="SwitchOnBrush" Color="#4E6EF2"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#C2C7C4"/>
    <SolidColorBrush x:Key="SwitchKnobBrush" Color="#FFFFFF"/>

    <!-- 圆角：Material 大圆角，按钮全圆角 -->
    <CornerRadius x:Key="CardRadius">18</CornerRadius>
    <CornerRadius x:Key="BtnRadius">20</CornerRadius>
    <CornerRadius x:Key="SwitchRadius">13</CornerRadius>
</ResourceDictionary>
