<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 主题标识（ThemeService 据此定位并替换当前主题字典） -->
    <sys:String x:Key="ThemeName">default</sys:String>

    <!-- 颜色 -->
    <SolidColorBrush x:Key="ThemeBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="BgBrush" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#232A33"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#33404D"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#2C3540"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="RedBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="SecondaryBgBrush" Color="#E5E7EB"/>

    <!-- 侧边栏文字 -->
    <SolidColorBrush x:Key="NavTextBrush" Color="#C7CDD6"/>
    <SolidColorBrush x:Key="NavSubTextBrush" Color="#9AA4B2"/>

    <!-- 开关 -->
    <SolidColorBrush x:Key="SwitchOnBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#C4C9D1"/>
    <SolidColorBrush x:Key="SwitchKnobBrush" Color="#FFFFFF"/>

    <!-- 圆角 -->
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="BtnRadius">6</CornerRadius>
    <CornerRadius x:Key="SwitchRadius">11</CornerRadius>
</ResourceDictionary>
