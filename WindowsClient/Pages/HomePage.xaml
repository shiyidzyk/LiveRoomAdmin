<UserControl x:Class="LiveRoomAdmin.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
      Background="{DynamicResource BgBrush}">
    <UserControl.Resources>
        <Style x:Key="CopyBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource S_HomeTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TxtSub" Text="{DynamicResource S_HomeSub}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnLive" Content="{DynamicResource S_BtnStartLive}" Style="{StaticResource PrimaryBtnStyle}"
                        Background="{DynamicResource GreenBrush}" FontWeight="Bold" Click="BtnLive_Click"/>
                <Button x:Name="BtnReconnect" Content="{DynamicResource S_BtnReconnect}" Style="{StaticResource SecondaryBtnStyle}" Click="BtnReconnect_Click"/>
                <Button x:Name="BtnAdminLogin" Content="{DynamicResource S_BtnAdminLogin}" Style="{StaticResource PrimaryBtnStyle}" Click="BtnAdminLogin_Click"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource CardStyle}">
            <StackPanel Orientation="Horizontal">
                <Border Background="#FFF7E6" CornerRadius="8" Padding="12,7" Margin="0,0,10,0" BorderBrush="#F5D9A0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_LblAdminUser}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtAdminUser" Text="admin" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Button Content="{DynamicResource S_LblCopy}" Style="{StaticResource CopyBtnStyle}" Click="BtnCopyAdminUser_Click"/>
                    </StackPanel>
                </Border>
                <Border Background="#FFF7E6" CornerRadius="8" Padding="12,7" Margin="0,0,10,0" BorderBrush="#F5D9A0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_LblAdminPass}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtAdminPass" Text="admin123" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Button Content="{DynamicResource S_LblCopy}" Style="{StaticResource CopyBtnStyle}" Click="BtnCopyAdminPass_Click"/>
                    </StackPanel>
                </Border>
                <Border x:Name="WrapRtmp" Background="#F6F8FA" CornerRadius="8" Padding="12,7" Margin="0,0,10,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_LblStreamUrl}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtRtmp" Text="-" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Button Content="{DynamicResource S_LblCopy}" Style="{StaticResource CopyBtnStyle}" Click="BtnCopyRtmp_Click"/>
                    </StackPanel>
                </Border>
                <Border x:Name="WrapKey" Background="#F6F8FA" CornerRadius="8" Padding="12,7" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_LblStreamKey}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtKey" Text="-" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Button Content="{DynamicResource S_LblCopy}" Style="{StaticResource CopyBtnStyle}" Click="BtnCopyKey_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                <Grid>
                    <Border x:Name="VideoHost" Background="#0B0F14" CornerRadius="8" ClipToBounds="True">
                        <vlc:VideoView x:Name="VlcView"/>
                    </Border>
                    <Border x:Name="Overlay" Background="#CC000000" CornerRadius="8" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtOverlayMsg" Text="" FontSize="30" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="LoadingMask" Background="#55000000" CornerRadius="8">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource S_TxtConnecting}" FontSize="16" Foreground="#DDDDDD"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border x:Name="CardWebLink" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_LblWebRoom}" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource S_LblWebRoomDesc}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource InputBgBrush}" CornerRadius="6" Padding="10,7" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtWebLink" Text="" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="点击右侧按钮复制链接"/>
                                </Border>
                                <Button Grid.Column="1" Content="复制" Margin="8,0,0,0" Padding="12,7"
                                        Style="{StaticResource SecondaryBtnStyle}" Click="BtnCopyWebLink_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_LblOnlineStatus}" Style="{StaticResource CardTitleStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TxtOnline" Text="0" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource ThemeBrush}"/>
                                    <TextBlock Text="{DynamicResource S_LblOnlineCount}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TxtUptime" Text="0s" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}"/>
                                    <TextBlock Text="{DynamicResource S_LblUptime}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="TxtAccounts" Text="0" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AmberBrush}"/>
                                    <TextBlock Text="{DynamicResource S_LblAccounts}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_LblViewers}" Style="{StaticResource CardTitleStyle}"/>
                            <ListBox x:Name="ListViewers" Height="150" FontSize="12"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{DynamicResource S_AdminTag}" FontSize="10" Foreground="{DynamicResource AmberBrush}" Visibility="{Binding RoleVisibility}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_LblChatGifts}" Style="{StaticResource CardTitleStyle}"/>
                            <ListBox x:Name="ListChat" Height="200" FontSize="12"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
