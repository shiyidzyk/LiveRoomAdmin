<UserControl x:Class="LiveRoomAdmin.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgBrush}">
    <UserControl.Resources>
        <Style x:Key="ThemeDropdownBtnStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource BtnRadius}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeMenuItemStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,16,0"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{DynamicResource S_SetTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,8,0,14"/>
                <RadioButton x:Name="MenuServer" Content="{DynamicResource S_SetServer}" GroupName="SetMenu"
                             Style="{StaticResource NavBtnStyle}"
                             Checked="MenuServer_Checked"/>
                <RadioButton x:Name="MenuAppearance" Content="{DynamicResource S_SetAppearance}" GroupName="SetMenu"
                             Style="{StaticResource NavBtnStyle}" Checked="MenuAppearance_Checked"/>
                <RadioButton x:Name="MenuAbout" Content="{DynamicResource S_SetAbout}" GroupName="SetMenu"
                             Style="{StaticResource NavBtnStyle}" Checked="MenuAbout_Checked" Unchecked="MenuAbout_Unchecked"/>
                <StackPanel x:Name="AboutSubMenu" Margin="20,0,0,0" Visibility="Collapsed">
                    <RadioButton x:Name="MenuChangelog" Content="{DynamicResource S_SetChangelog}" GroupName="SetSubMenu"
                                 Style="{StaticResource NavBtnStyle}" Checked="MenuChangelog_Checked"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1">
            <ScrollViewer x:Name="PanelServer" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel>
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource S_SetServer}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource S_ServerPanelDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,16,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_ServerConfig}" Style="{StaticResource CardTitleStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource S_ServerHost}" Width="90" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtHost" Width="220" Style="{StaticResource InputStyle}"/>
                                <TextBlock Text="{DynamicResource S_ServerPort}" Width="50" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtPort" Width="90" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox x:Name="ChkAutoDetect" Content="{DynamicResource S_AutoDetect}" FontSize="13" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0"/>
                                <Button x:Name="BtnDetect" Content="{DynamicResource S_DetectNow}" Style="{StaticResource PrimaryBtnStyle}" Click="BtnDetect_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource S_SaveReconnect}" Style="{StaticResource PrimaryBtnStyle}" Click="BtnSave_Click"/>
                                <Button Content="{DynamicResource S_TestConn}" Style="{StaticResource SecondaryBtnStyle}" Click="BtnTest_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtTestResult" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_ObsRef}" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource S_ObsRefDesc}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource S_ObsRefTip}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource S_SetAdminWeb}" Style="{StaticResource CardTitleStyle}"/>
                                <CheckBox x:Name="ChkAdminWeb" Content="{DynamicResource S_SetAdminWebDesc}"
                                          Style="{StaticResource SwitchStyle}" Margin="16,0,0,0"
                                          Checked="ChkAdminWeb_Changed" Unchecked="ChkAdminWeb_Changed"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtAdminWebUrl" Text="开启后，同局域网内可通过 http://服务器IP:3000/admin.html 进入管理页（仅本机集成服务生效）"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="PanelAppearance" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource S_SetAppearance}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource S_AppearancePanelDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,16,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_ThemeStyleTitle}" Style="{StaticResource CardTitleStyle}"/>
                            <Grid>
                                <Button x:Name="BtnTheme" Style="{StaticResource ThemeDropdownBtnStyle}" Click="BtnTheme_Click">
                                    <Grid>
                                        <TextBlock x:Name="TxtTheme" Text="原版" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <TextBlock Text="⌄" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                </Button>
                                <Popup x:Name="ThemePopup" StaysOpen="False" Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=BtnTheme}"
                                       AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Width="300" Background="{DynamicResource CardBrush}" CornerRadius="16"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.28" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Button x:Name="ThemeDefault" Tag="default" Style="{StaticResource ThemeMenuItemStyle}" Click="ThemeItem_Click">
                                                <Grid>
                                                    <TextBlock Text="原版" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    <TextBlock x:Name="TickDefault" Text="✓" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Button>
                                            <Button x:Name="ThemeMiuix" Tag="miuix" Style="{StaticResource ThemeMenuItemStyle}" Click="ThemeItem_Click">
                                                <Grid>
                                                    <TextBlock Text="Miuix" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    <TextBlock x:Name="TickMiuix" Text="✓" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Button>
                                            <Button x:Name="ThemeMaterial" Tag="material" Style="{StaticResource ThemeMenuItemStyle}" Click="ThemeItem_Click">
                                                <Grid>
                                                    <TextBlock Text="Material" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    <TextBlock x:Name="TickMaterial" Text="✓" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <TextBlock Text="{DynamicResource S_ThemeDescDefault}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0"/>
                            <TextBlock Text="{DynamicResource S_ThemeDescMiuix}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                            <TextBlock Text="{DynamicResource S_ThemeDescMaterial}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_LangCardTitle}" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource S_LangDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LangZh" Content="{DynamicResource S_LangZh}" GroupName="LangGrp" FontSize="13"
                                             Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,26,0"
                                             VerticalAlignment="Center" Cursor="Hand" Checked="Lang_Changed"/>
                                <RadioButton x:Name="LangEn" Content="{DynamicResource S_LangEn}" GroupName="LangGrp" FontSize="13"
                                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Cursor="Hand" Checked="Lang_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="PanelAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource S_SetAbout}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource S_AboutPanelDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,16,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource ThemeBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="直" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAppName" Text="直播间管理终端" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtVersion" Text="1.00.03.beta" FontSize="13" Foreground="{DynamicResource ThemeBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="TxtBuildInfo" Text="{DynamicResource S_BuildInfo}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_ChangelogTitle}" Style="{StaticResource CardTitleStyle}"/>
                            <Border Background="#0B0F14" CornerRadius="8" Padding="16,12" Height="360">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TxtChangelog" FontFamily="Consolas" FontSize="12.5"
                                               Foreground="#C9D4E0" TextWrapping="Wrap" LineHeight="22"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
